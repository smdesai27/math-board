  "board_snapshot": {
    "type": "object",
    "properties": {
      "region": {
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "minimum": 10
          },
          "h": {
            "type": "number",
            "minimum": 10
          }
        },
        "description": "Board-space area (default: camera view)"
      },
      "width": {
        "type": "number",
        "description": "Image px (default 1200, max 2400)"
      },
      "chapter": {
        "type": "string",
        "description": "Chapter to capture"
      },
      "overview": {
        "type": "boolean",
        "description": "All chapters"
      }
    }
  },
  "board_library": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Keywords, e.g. 'heart cross section'"
      },
      "category": {
        "type": "string",
        "description": "Category substring"
      },
      "limit": {
        "type": "number",
        "description": "Default 25"
      }
    }
  },
  "board_save": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "anyOf": [
          {
            "type": "string",
            "const": "save"
          },
          {
            "type": "string",
            "const": "load"
          },
          {
            "type": "string",
            "const": "list"
          }
        ],
        "description": "load replaces the board"
      },
      "name": {
        "type": "string",
        "description": "[A-Za-z0-9._-], default 'default'"
      },
      "baseRevision": {
        "type": "integer",
        "minimum": 0,
        "description": "Required for load"
      }
    }
  },
  "board_docs": {
    "type": "object",
    "required": [
