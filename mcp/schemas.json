    ],
    "properties": {
      "topic": {
        "type": "string",
        "enum": [
          "overview",
          "workflow",
          "chapters",
          "equations",
          "marks",
          "plot",
          "svg",
          "mermaid",
          "molecule",
          "icon",
          "html",
          "animation",
          "layout",
          "saves"
        ],
        "description": "overview lists what you can draw"
      }
