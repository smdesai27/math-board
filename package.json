{
  "name": "pi-math-board",
  "version": "0.3.1",
  "description": "A view-only chalkboard in the browser that a terminal tutor draws on: equations, plots, molecules, diagrams and science illustrations, built up one step at a time. A pi extension and an MCP server.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "mcp",
    "mcp-server",
    "claude-code",
    "blackboard",
    "chalkboard",
    "tutor",
    "learning",
    "katex",
    "mermaid",
    "chemistry",
    "physics"
  ],
  "homepage": "https://github.com/smdesai27/math-board#readme",
  "bugs": {
    "url": "https://github.com/smdesai27/math-board/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smdesai27/math-board.git"
  },
  "license": "MIT",
  "author": "Sanil Desai (https://github.com/smdesai27)",
  "type": "module",
  "bin": {
    "pi-math-board": "mcp/server.mjs"
  },
  "files": [
    "index.ts",
    "tools.mjs",
    "server.mjs",
    "export.mjs",
    "snapshot.mjs",
    "native-import.mjs",
    "shared/",
    "mcp/",
    "public/",
    "browser/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/design.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "mcpName": "io.github.smdesai27/math-board",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@rgrove/parse-xml": "5.0.0",
    "playwright-core": "1.64.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:load": "node scripts/verify-import.mjs && node scripts/verify-reload.mjs",
    "typecheck": "tsc --noEmit",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "$katex"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "mermaid": "11.17.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "smiles-drawer": "2.4.1",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
